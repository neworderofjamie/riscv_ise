# Include common makefile
SELF_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
include $(SELF_DIR)MakefileCommon

APP:=$(BIN_DIRECTORY)/$(APP_NAME)$(PREFIX)
LDFLAGS+=$(APP_DEPENDENCIES:%=-l%$(PREFIX))

.PHONY: all clean common fenn_common fenn_assembler fenn_ise

all: $(APP)

-include event_camera.d

$(APP): $(APP_NAME).cc $(APP_NAME).d $(APP_DEPENDENCIES)
	mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(APP_NAME).cc -o $@ $(LDFLAGS)

common:
	if [ -w $(LIBRARY_DIRECTORY) ]; then $(MAKE) -C $(RISCV_DIR)/src/common; fi;

fenn_common:
	if [ -w $(LIBRARY_DIRECTORY) ]; then $(MAKE) -C $(RISCV_DIR)/src/fenn/common; fi;

fenn_assembler:
	if [ -w $(LIBRARY_DIRECTORY) ]; then $(MAKE) -C $(RISCV_DIR)/src/fenn/assembler; fi;

fenn_ise:
	if [ -w $(LIBRARY_DIRECTORY) ]; then $(MAKE) -C $(RISCV_DIR)/src/fenn/ise; fi;

%.d: ;

clean:
	rm -f $(COMPILER_TEST)
